---
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout title="404 - Halaman Tidak Ditemukan | SIM4LON">
  <div class="min-h-screen flex items-center justify-center p-6 relative overflow-hidden" style="background: linear-gradient(180deg, #f0fdf4 0%, #ffffff 40%, #ecfdf5 100%);">
    <!-- Decorative background elements -->
    <div class="absolute top-0 right-0 w-96 h-96 rounded-full opacity-30" style="background: radial-gradient(circle, rgba(16, 185, 129, 0.15) 0%, transparent 70%);"></div>
    <div class="absolute bottom-0 left-0 w-80 h-80 rounded-full opacity-25" style="background: radial-gradient(circle, rgba(20, 184, 166, 0.2) 0%, transparent 70%);"></div>
    
    <!-- Subtle pattern overlay -->
    <div class="absolute inset-0 opacity-[0.015]" style="background-image: url('data:image/svg+xml,<svg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"><g fill=\"none\" fill-rule=\"evenodd\"><g fill=\"%23059669\" fill-opacity=\"1\"><path d=\"M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\"/></g></g></svg></div>

    <div class="relative z-10 text-center max-w-lg mx-auto">
      <!-- Custom Illustration with shadow -->
      <div class="mb-8 relative">
        <div class="absolute inset-0 blur-3xl opacity-20 scale-75" style="background: radial-gradient(circle, #10b981 0%, transparent 70%);"></div>
        <img 
          src="/images/404-illustration.png" 
          alt="Tabung LPG kebingungan" 
          class="w-56 h-56 md:w-72 md:h-72 mx-auto object-contain relative z-10 drop-shadow-2xl"
          style="animation: float 4s ease-in-out infinite;"
        />
      </div>

      <!-- Error code badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-50 border border-emerald-200 mb-6">
        <span class="text-sm font-semibold text-emerald-700">Error 404</span>
      </div>

      <!-- Main heading -->
      <h1 class="text-3xl md:text-4xl font-bold text-slate-800 mb-3">
        Halaman Tidak Ditemukan
      </h1>

      <!-- Description -->
      <p class="text-slate-500 text-base md:text-lg mb-8 leading-relaxed max-w-md mx-auto">
        Waduh, sepertinya tabung LPG kita nyasar! 
        Halaman yang kamu cari tidak ada atau sudah dipindahkan.
      </p>

      <!-- Action buttons -->
      <div class="flex flex-col sm:flex-row gap-3 justify-center mb-6">
        <a 
          href="./dashboard-admin.html" 
          class="group inline-flex items-center justify-center gap-2 px-6 py-3.5 text-white font-semibold rounded-xl transition-all duration-300 hover:-translate-y-1"
          style="background: linear-gradient(135deg, #059669 0%, #10b981 100%); box-shadow: 0 4px 14px 0 rgba(5, 150, 105, 0.35);"
        >
          <svg class="w-5 h-5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
          </svg>
          Kembali ke Dashboard
        </a>
        <button 
          onclick="history.back()"
          class="group inline-flex items-center justify-center gap-2 px-6 py-3.5 text-slate-600 font-semibold bg-white border border-slate-200 rounded-xl transition-all duration-300 hover:border-emerald-300 hover:text-emerald-700 hover:-translate-y-1 hover:shadow-lg"
        >
          <svg class="w-5 h-5 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Halaman Sebelumnya
        </button>
      </div>

      <!-- Help section -->
      <div class="pt-6 border-t border-slate-100">
        <p class="text-sm text-slate-400">
          Butuh bantuan? 
          <a href="mailto:luthffahmi.alv@gmail.com" class="text-emerald-600 hover:text-emerald-700 font-medium hover:underline">
            Hubungi Administrator
          </a>
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  @keyframes float {
    0%, 100% { 
      transform: translateY(0px) rotate(0deg); 
    }
    25% {
      transform: translateY(-8px) rotate(1deg);
    }
    50% { 
      transform: translateY(-12px) rotate(0deg); 
    }
    75% {
      transform: translateY(-8px) rotate(-1deg);
    }
  }
</style>
