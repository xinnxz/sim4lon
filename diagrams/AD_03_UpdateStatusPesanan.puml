@startuml AD_03_UpdateStatusPesanan
!theme plain
skinparam backgroundColor #f0f8ff
skinparam ActivityBackgroundColor #87CEEB
skinparam ActivityBorderColor #1565c0

title **AD-03: Update Status Pesanan**\nSistem SIM4LON

|User|
start
:Buka detail pesanan;

switch (Pilih Aksi?)
case (Konfirmasi\nPesanan)
    |Sistem|
    :Update status → MENUNGGU_PEMBAYARAN;
    :Buat timeline track;
    
case (Konfirmasi\nPembayaran)
    |Sistem|
    :Update status → DIPROSES;
    :Simpan payment method;
    :Buat timeline track;
    
case (Assign Driver\n& Kirim)
    |User|
    :Pilih driver dari daftar;
    |Sistem|
    :Assign driver ke pesanan;
    :Update status → DIKIRIM;
    :Buat timeline track;
    
case (Pesanan\nSelesai)
    |Sistem|
    :Update status → SELESAI;
    :Update stok pangkalan;
    :Buat stock movement;
    :Update penyaluran harian;
    :Buat timeline track;
    :Log aktivitas;
    
case (Batalkan\nPesanan)
    |Sistem|
    :Update status → BATAL;
    :Kembalikan stok agen;
    :Reset payment details;
    :Buat timeline track;
    :Log aktivitas;
    
endswitch

|User|
:Tampilkan notifikasi sukses;
:Refresh halaman detail;

stop

note right
  Alur Status:
  DRAFT → MENUNGGU_PEMBAYARAN
  → DIPROSES → DIKIRIM → SELESAI
  (Semua bisa → BATAL)
end note

@enduml
