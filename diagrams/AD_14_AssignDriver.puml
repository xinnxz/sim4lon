@startuml AD_14_AssignDriver
!theme plain
skinparam backgroundColor #f0f8ff
skinparam ActivityBackgroundColor #87CEEB
skinparam ActivityBorderColor #1565c0

title **AD-14: Assign Driver**\nSistem SIM4LON

|User|
start
:Buka detail pesanan;
:Klik "Assign Driver";

|Sistem|
:Load daftar driver aktif;
:Cek status kesibukan driver;
:Tampilkan modal pilih driver;

note right
  Driver dengan status
  "Sedang Mengantar"
  ditampilkan tapi disabled
end note

|User|
:Pilih driver yang tersedia;

|Sistem|
if (Driver sedang sibuk?) then (ya)
    |User|
    :Tampilkan badge "Mengantar";
    :Tidak bisa dipilih;
    stop
else (tidak)
    :Assign driver ke pesanan;
    :Update status → DIKIRIM;
    :Buat timeline track;
    
    |User|
    :Tampilkan notifikasi sukses;
    :Tutup modal;
    :Refresh halaman detail;
    stop
endif

@enduml
