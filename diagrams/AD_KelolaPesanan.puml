@startuml AD_KelolaPesanan
!theme plain
skinparam backgroundColor #f0f8ff
skinparam ActivityBackgroundColor #87CEEB
skinparam ActivityBorderColor #1565c0

title **AD: Kelola Pesanan (Admin/Operator)**\nSistem SIM4LON

|Admin/Operator|
start

:Buka menu Pesanan;

|Sistem|
:Load daftar pesanan;
:Tampilkan statistik\n(hari ini);
:Tampilkan halaman\nDaftar Pesanan;

|Admin/Operator|
:Lihat daftar pesanan;

if (Aksi?) then (Buat Pesanan)
    #palegreen:<<AD-02>>\nBuat Pesanan|
elseif (Lihat Detail) then
    #palegreen:<<AD-15>>\nLihat Detail Pesanan|
elseif (Update Status) then
    #palegreen:<<AD-03>>\nUpdate Status Pesanan|
elseif (Catat Pembayaran) then
    #palegreen:<<AD-04>>\nCatat Pembayaran|
elseif (Assign Driver) then
    #palegreen:<<AD-14>>\nAssign Driver|
elseif (Cetak Dokumen) then
    #palegreen:<<AD-16>>\nGenerate Invoice/Nota|
else (Batalkan)
    |Sistem|
    :Konfirmasi pembatalan;
    :Update status = BATAL;
    :Catat timeline;
endif

|Admin/Operator|
stop

legend right
**Keterangan:**
|<#palegreen> Simbol |= Artinya |
| <<AD-XX>>\\nNama| | Call Behavior\n(Sub-Activity) |
endlegend

@enduml
