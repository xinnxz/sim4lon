@startuml AD_25_LaporanPangkalan
!theme plain
skinparam backgroundColor #f0f8ff
skinparam ActivityBackgroundColor #87CEEB
skinparam ActivityBorderColor #1565c0
skinparam PartitionBackgroundColor #e3f2fd
skinparam PartitionBorderColor #1565c0

title **AD-25: Generate & Export Laporan (Pangkalan)**\nSistem SIM4LON

|#e3f2fd|Pangkalan|
start
:Buka halaman Laporan;
:Pilih periode (preset/custom);

|#e8f5e9|Sistem|
:Load data penjualan konsumen;
:Load data pengeluaran;
:Hitung laba/rugi;

|Pangkalan|
:Lihat ringkasan:
- Total Penjualan
- Total Pengeluaran  
- Laba Bersih;

:Lihat grafik trend;
:Lihat tabel transaksi;

if (Export?) then (ya)
    :Pilih format;
    
    split
        :Export Excel;
        |Sistem|
        :Generate XLSX dengan:
        - Summary
        - Detail Penjualan
        - Detail Pengeluaran;
    split again
        :Export PDF;
        |Sistem|
        :Generate PDF report;
    end split
    
    |Sistem|
    :Download file;
    
    |Pangkalan|
    :File tersimpan;
endif

stop

note right
  Pangkalan hanya
  melihat data milik
  sendiri (multi-tenant)
end note

@enduml
