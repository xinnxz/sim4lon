@startuml AD_02_BuatPesanan_Voice
!theme plain
skinparam backgroundColor #f0f8ff
skinparam ActivityBackgroundColor #87CEEB
skinparam ActivityBorderColor #1565c0
skinparam PartitionBackgroundColor #e3f2fd
skinparam PartitionBorderColor #1565c0

title **AD-02: Buat Pesanan (Manual)**\nSistem SIM4LON

|User|
start
:Buka halaman Pesanan;
:Klik "Buat Pesanan Baru";

|Sistem|
:Tampilkan form pesanan;
:Load daftar Pangkalan aktif;
:Load daftar Produk LPG;

|User|
:Pilih Pangkalan tujuan;
:Pilih jenis LPG dari dropdown;
:Input jumlah (quantity);

if (Tambah item lain?) then (ya)
    :Klik "Tambah Item";
    :Pilih jenis LPG lain;
    :Input jumlah;
else (tidak)
endif

:Tambahkan catatan (opsional);
:Klik "Simpan";

|Sistem|
:Validasi input;

if (Pangkalan dipilih?) then (tidak)
    |User|
    :Tampilkan error:\n"Pilih pangkalan";
    stop
else (ya)
endif

if (Item LPG ada?) then (tidak)
    |User|
    :Tampilkan error:\n"Tambahkan minimal 1 item";
    stop
else (ya)
endif

if (Quantity valid?) then (tidak)
    |User|
    :Tampilkan error:\n"Jumlah harus > 0";
    stop
else (ya)
endif

:Generate kode pesanan\n(ORD-XXXX);
:Hitung subtotal per item;
:Hitung PPN (12% untuk non-subsidi);
:Hitung total amount;
:Simpan pesanan\ndengan status DRAFT;
:Buat timeline track\n"Pesanan Dibuat";
:Log aktivitas\n"order_created";

|User|
:Tampilkan pesan sukses;
:Redirect ke detail pesanan;
stop

legend right
  |= Icon |= Keterangan |
  | 📝 | Form Input Manual |
  | ✓ | Validasi Frontend |
  | 💾 | Simpan ke Database |
endlegend

@enduml
