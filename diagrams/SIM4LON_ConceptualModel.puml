@startuml SIM4LON_ConceptualModel

!define OPERATIONAL_COLOR #E8F5E9
!define TECH_COLOR #E3F2FD
!define MANAGERIAL_COLOR #FFF3E0
!define CORE_COLOR #FFEBEE
!define OUTCOME_COLOR #F3E5F5

skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundcorner 8
skinparam shadowing true

skinparam rectangle {
    BorderColor #546E7A
    FontSize 10
}

skinparam package {
    BorderColor #37474F
    BackgroundColor white
    FontStyle bold
}

title <size:18>**Conceptual Model of SIM4LON**</size>\n<size:12>Integrated Information System for Optimizing LPG Distribution</size>

' ==================== OPERATIONAL FACTORS ====================
package "**OPERATIONAL FACTORS**" as OPS <<Rectangle>> #E8F5E9 {
    rectangle "**ORDER MANAGEMENT**" as order #FFFFFF {
        rectangle "Order Creation" as order1 #C8E6C9
        rectangle "Status Tracking" as order2 #C8E6C9
        rectangle "Driver Assignment" as order3 #C8E6C9
    }
    
    rectangle "**SCHEDULING**" as sched #FFFFFF {
        rectangle "Delivery Queue" as sched1 #C8E6C9
        rectangle "Route Planning" as sched2 #C8E6C9
    }
    
    rectangle "**DEMAND PATTERN**" as demand #FFFFFF {
        rectangle "Pangkalan Requests" as demand1 #C8E6C9
        rectangle "Volume Tracking" as demand2 #C8E6C9
    }
}

' ==================== TECHNOLOGICAL FACTORS ====================
package "**TECHNOLOGICAL FACTORS**" as TECH <<Rectangle>> #E3F2FD {
    rectangle "**INTEGRATED DATABASE**" as db #FFFFFF {
        rectangle "PostgreSQL" as db1 #BBDEFB
        rectangle "Multi-tenant Schema" as db2 #BBDEFB
        rectangle "Data Isolation" as db3 #BBDEFB
    }
    
    rectangle "**AUTOMATED SYSTEM**" as auto #FFFFFF {
        rectangle "Status Automation" as auto1 #BBDEFB
        rectangle "Stock Sync" as auto2 #BBDEFB
        rectangle "Report Generation" as auto3 #BBDEFB
    }
    
    rectangle "**USER INTERFACE**" as ui #FFFFFF {
        rectangle "React Frontend" as ui1 #BBDEFB
        rectangle "Responsive Design" as ui2 #BBDEFB
        rectangle "Role-based Views" as ui3 #BBDEFB
    }
}

' ==================== MANAGERIAL FACTORS ====================
package "**MANAGERIAL FACTORS**" as MGR <<Rectangle>> #FFF3E0 {
    rectangle "**ACCESS CONTROL**" as access #FFFFFF {
        rectangle "Role Management" as access1 #FFE0B2
        rectangle "JWT Authentication" as access2 #FFE0B2
        rectangle "Single Session" as access3 #FFE0B2
    }
    
    rectangle "**PAYMENT POLICIES**" as pay #FFFFFF {
        rectangle "DP Tracking" as pay1 #FFE0B2
        rectangle "Installment" as pay2 #FFE0B2
        rectangle "Payment Status" as pay3 #FFE0B2
    }
    
    rectangle "**DATA SECURITY**" as sec #FFFFFF {
        rectangle "Activity Logging" as sec1 #FFE0B2
        rectangle "Audit Trail" as sec2 #FFE0B2
    }
}

' ==================== INTEGRATED INFORMATION SYSTEM ====================
package "**INTEGRATED INFORMATION SYSTEM**" as IIS <<Rectangle>> #FFEBEE {
    rectangle "**BUSINESS PROCESS**" as bp #FFFFFF {
        rectangle "Ordering" as bp1 #FFCDD2
        rectangle "Distribution" as bp2 #FFCDD2
        rectangle "Payment" as bp3 #FFCDD2
        rectangle "Reporting" as bp4 #FFCDD2
    }
    
    rectangle "**UML DESIGN**" as uml #FFFFFF {
        rectangle "Use Case" as uml1 #FFCDD2
        rectangle "Activity Diagram" as uml2 #FFCDD2
        rectangle "Sequence Diagram" as uml3 #FFCDD2
        rectangle "ERD" as uml4 #FFCDD2
    }
    
    rectangle "**INFRASTRUCTURE**" as infra #FFFFFF {
        rectangle "Hardware\n(Cloud)" as infra1 #FFCDD2
        rectangle "Software\n(React+NestJS)" as infra2 #FFCDD2
        rectangle "Data\n(PostgreSQL)" as infra3 #FFCDD2
    }
}

' ==================== OPTIMIZING OUTCOME ====================
rectangle "<size:14>**OPTIMIZING LPG DISTRIBUTION**</size>\n\n• Reduced order processing time\n• Improved stock accuracy\n• Real-time delivery tracking\n• Automated report generation\n• Enhanced multi-tenant data isolation" as OUTCOME #E1BEE7

' ==================== RELATIONSHIPS ====================
OPS -[#4CAF50,thickness=2]-> IIS : <color:#4CAF50>supports
TECH -[#2196F3,thickness=2]-> IIS : <color:#2196F3>enables
MGR -[#FF9800,thickness=2]-> IIS : <color:#FF9800>governs
IIS -[#9C27B0,thickness=3]-> OUTCOME : <color:#9C27B0>**achieves**

' Legend
legend right
  |= Color |= Factor |
  | <#C8E6C9> | Operational |
  | <#BBDEFB> | Technological |
  | <#FFE0B2> | Managerial |
  | <#FFCDD2> | Core System |
  | <#E1BEE7> | Outcome |
endlegend

footer \n**SIM4LON - LPG Distribution Management System**\nCianjur Regency, West Java, Indonesia

@enduml
