@startuml AD_04_CatatPembayaran
!theme plain
skinparam backgroundColor #f0f8ff
skinparam ActivityBackgroundColor #87CEEB
skinparam ActivityBorderColor #1565c0

title **AD-04: Catat Pembayaran**\nSistem SIM4LON

|User|
start
:Buka detail pesanan;
:Klik "Catat Pembayaran";

|Sistem|
:Tampilkan form pembayaran;
:Tampilkan ringkasan pesanan;

|User|
:Pilih metode pembayaran;

switch (Metode?)
case (TUNAI)
    :Masukkan jumlah bayar;
case (TRANSFER)
    :Masukkan jumlah bayar;
    :Upload bukti transfer;
endswitch

:Tambah catatan (opsional);
:Klik "Simpan";

|Sistem|
:Validasi input;

if (Input valid?) then (ya)
    if (Metode = TRANSFER?) then (ya)
        :Upload bukti ke Supabase Storage;
        :Simpan URL bukti transfer;
    endif
    
    :Simpan payment record;
    :Set is_paid = true;
    :Update order_payment_details;
    
    if (Status = MENUNGGU_PEMBAYARAN?) then (ya)
        :Auto update status → DIPROSES;
    endif
    
    |User|
    :Tampilkan notifikasi sukses;
    :Redirect ke detail pesanan;
    stop
else (tidak)
    |User|
    :Tampilkan pesan error;
    stop
endif

@enduml
