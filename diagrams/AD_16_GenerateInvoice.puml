@startuml AD_16_GenerateInvoice
!theme plain
skinparam backgroundColor #f0f8ff
skinparam ActivityBackgroundColor #87CEEB
skinparam ActivityBorderColor #1565c0
skinparam PartitionBackgroundColor #e3f2fd
skinparam PartitionBorderColor #1565c0

title **AD-16: Generate Invoice / Nota**\nSistem SIM4LON

|#e3f2fd|User|
start
:Buka Detail Pesanan;
:Klik "Cetak Invoice/Nota";

|#e8f5e9|Sistem|
:Navigasi ke halaman dokumen;
:Fetch data order;

if (Order ditemukan?) then (ya)
    :Load company profile;
    :Cek status pembayaran;
    
    |User|
    if (Sudah lunas?) then (ya)
        :Pilih: Invoice atau Nota;
    else (tidak)
        :Tampilkan Invoice saja;
    endif
    
    |Sistem|
    :Generate nomor dokumen;
    :Render dokumen;
    
    |User|
    :Lihat dokumen;
    
    split
        :Cetak (Print);
    split again
        :Share WhatsApp;
    split again
        :Copy Link;
    end split
    
    stop
    
else (tidak)
    |User|
    :Tampilkan error;
    stop
endif

note right
  **Catatan:**
  Invoice = pre-payment
  Nota = post-payment (lunas)
  
  Keduanya di-render
  on-demand dari data Order.
end note

@enduml
