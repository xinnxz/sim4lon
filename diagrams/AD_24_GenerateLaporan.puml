@startuml AD_24_GenerateLaporan
!theme plain
skinparam backgroundColor #f0f8ff
skinparam ActivityBackgroundColor #87CEEB
skinparam ActivityBorderColor #1565c0
skinparam PartitionBackgroundColor #e3f2fd
skinparam PartitionBorderColor #1565c0

title **AD-24: Generate & Export Laporan (Agen)**\nSistem SIM4LON

|#e3f2fd|Admin/Operator|
start
:Buka halaman Laporan;
:Pilih periode (preset/custom);

:Pilih tab laporan;

switch (Tab?)
case (Penjualan)
    :Filter: status, pangkalan;
    
    |#e8f5e9|Sistem|
    :Query orders;
    :Hitung summary;
    :Tampilkan grafik & tabel;

case (Stok)
    :Filter: jenis LPG;
    
    |Sistem|
    :Query stock_histories;
    :Hitung masuk/keluar;
    :Tampilkan grafik & tabel;

case (Per Pangkalan)
    :Pilih pangkalan;
    
    |Sistem|
    :Query orders per pangkalan;
    :Hitung ranking;
    :Tampilkan data per pangkalan;

endswitch

|Admin/Operator|
:Lihat laporan;

if (Export?) then (ya)
    :Pilih format;
    
    split
        :Export Excel;
        |Sistem|
        :Generate XLSX;
    split again
        :Export PDF;
        |Sistem|
        :Generate PDF;
    end split
    
    |Sistem|
    :Download file;
    
    |Admin/Operator|
    :File tersimpan;
endif

stop

@enduml
