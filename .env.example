# Frontend Environment Variables
# Copy this file to .env and fill in the values

# Backend API URL - untuk production di Vercel, biarkan kosong (akan pakai /api)
# Untuk local dengan backend terpisah: http://localhost:3000/api
# PUBLIC_API_URL=

# Database URL - Supabase PostgreSQL Connection (Pooling)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL - Supabase PostgreSQL Connection (untuk migrations)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# JWT Secret - harus sama dengan yang di backend
JWT_SECRET="sim4lon-jwt-secret-key-2024"
